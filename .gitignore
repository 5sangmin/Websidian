# =========================
# Websidian root .gitignore
# =========================

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.code-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local
infra/compose/.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Frontend (Vue / Vite / Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.cache/

# Backend (Spring Boot / Gradle)
backend/build/
backend/.gradle/
backend/out/
backend/bin/

# Java / JVM
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Test / coverage / temp
coverage/
tmp/
temp/
.cache/
*.tmp
*.swp
*.swo

# Local database / misc
*.sqlite
*.sqlite3
*.db

# Python (in case helper scripts are added later)
.venv/
venv/
__pycache__/
*.pyc

# Docker / local runtime artifacts
docker-data/
data/